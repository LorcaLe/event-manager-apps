<?xml version="1.0" encoding="utf-8" ?>
<!-- "Events" tab: search by name, filter by date, pull down to refresh. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventManagerUser.ViewModels"
             xmlns:m="clr-namespace:EventManagerUser.Models"
             x:Class="EventManagerUser.Views.EventsPage"
             x:DataType="vm:EventsViewModel"
             Title="Events">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16,8,16,0" RowSpacing="4">

        <SearchBar Grid.Row="0"
                   Placeholder="Search events by name"
                   Text="{Binding SearchText}" />

        <!-- Date filter: tick to show only events taking place on that day -->
        <HorizontalStackLayout Grid.Row="1" Spacing="4">
            <CheckBox IsChecked="{Binding UseDateFilter}" VerticalOptions="Center" />
            <Label Text="On date" VerticalOptions="Center" />
            <DatePicker Date="{Binding FilterDate}"
                        Format="dd/MM/yyyy"
                        IsEnabled="{Binding UseDateFilter}"
                        VerticalOptions="Center" />
            <Button Text="Clear"
                    Command="{Binding ClearFiltersCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource Primary}"
                    Padding="8,0" />
        </HorizontalStackLayout>

        <!-- Offline / error message -->
        <Border Grid.Row="2"
                IsVisible="{Binding HasStatus}"
                Padding="12,8"
                Margin="0,4"
                StrokeShape="RoundRectangle 8"
                Stroke="Transparent"
                BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#4E342E}">
            <Label Text="{Binding StatusMessage}" FontSize="13" />
        </Border>

        <RefreshView Grid.Row="3"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Events}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center">
                        <Label Text="No events found" FontSize="18" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Try another name or date, or pull down to refresh."
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:EventItem">
                        <Border Margin="0,6"
                                Padding="16,12"
                                StrokeShape="RoundRectangle 16"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray900}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventsViewModel}}, Path=OpenEventCommand, x:DataType=vm:EventsViewModel}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold"
                                       MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="{Binding FavouriteIcon}"
                                        FontSize="24"
                                        WidthRequest="44" HeightRequest="44" Padding="0"
                                        BackgroundColor="Transparent"
                                        TextColor="#F9A825"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventsViewModel}}, Path=ToggleFavouriteCommand, x:DataType=vm:EventsViewModel}"
                                        CommandParameter="{Binding .}" />

                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding DateTimeText}"
                                       TextColor="{StaticResource Primary}" />
                                <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding LocationText}"
                                       TextColor="{StaticResource Gray500}" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding OrganiserText}"
                                       TextColor="{StaticResource Gray500}" MaxLines="1" LineBreakMode="TailTruncation" />

                                <!-- Type on the left, session count pinned to the right -->
                                <Grid Grid.Row="4" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                    <Border Padding="10,4" StrokeShape="RoundRectangle 8" Stroke="Transparent"
                                            BackgroundColor="{AppThemeBinding Light=#DEE0FF, Dark=#283BA3}"
                                            MaximumWidthRequest="170">
                                        <Label Text="{Binding Type}" FontSize="12"
                                               MaxLines="1" LineBreakMode="TailTruncation" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding SessionCountText}"
                                           HorizontalOptions="End" VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#00796B, Dark=#80CBC4}"
                                           FontAttributes="Bold" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
