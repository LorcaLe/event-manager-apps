<?xml version="1.0" encoding="utf-8" ?>
<!-- "Saved" tab (feature h): saved events, with a warning when one was postponed / cancelled. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EventManagerUser.ViewModels"
             xmlns:m="clr-namespace:EventManagerUser.Models"
             xmlns:views="clr-namespace:EventManagerUser.Views"
             x:Class="EventManagerUser.Views.FavouritesPage"
             x:DataType="vm:FavouritesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}"
             Title="Saved">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="20,20,20,8" Spacing="2">
            <Label Text="Your events" Style="{StaticResource MutedText}" FontSize="14" />
            <Label Text="Saved" FontSize="30" FontAttributes="Bold" CharacterSpacing="-0.5"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Favourites}" SelectionMode="None">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32" Spacing="8" HorizontalOptions="Center">
                        <Label Text="☆" FontSize="48" HorizontalTextAlignment="Center"
                               TextColor="{StaticResource StarGold}" />
                        <Label Text="No saved events yet" FontSize="18" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Tap the star on an event, or swipe it left and tap Save."
                               HorizontalTextAlignment="Center" Style="{StaticResource MutedText}" FontSize="14" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:EventItem">
                        <views:EventCard Margin="20,6" Tapped="OnCardTapped" StarTapped="OnCardStar" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
