<?xml version="1.0" encoding="utf-8"?>
<!--
    Add / edit event form (feature a), calendar-app style:
      - big inline event name, event type as chips;
      - "Starts" / "Ends" rows with date + time pills (tap to pick);
      - place, organiser and contact as rows with leading icons;
      - pinned actions: "Save as draft" and "Review & publish".
    Postponed / cancelled are not chosen here: a new event can only be a draft or
    published; the status of an existing event is changed from its detail screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:orientation="vertical"
    tools:context=".EventFormActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/screen_background">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/screen_background"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_close"
            tools:title="@string/title_add_event" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_m">

            <!-- ===== Name (big, inline) ===== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilName"
                style="@style/Widget.EventManager.TitleField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_event_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="100"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== Type as chips (one tap instead of a drop-down) ===== -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                app:chipSpacingVertical="0dp"
                app:singleSelection="true" />

            <TextView
                android:id="@+id/tvTypeError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:text="@string/error_type_required"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Shown only when "Other" is selected as the event type -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOtherType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:hint="@string/hint_other_type"
                android:visibility="gone"
                app:helperText="@string/helper_other_type"
                tools:visibility="visible">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textCapSentences"
                    android:maxLength="40" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== When ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventManager.FormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_m"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <!-- Starts: date + time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/Widget.EventManager.RowIcon"
                            android:layout_marginTop="14dp"
                            android:src="@drawable/ic_time" />

                        <TextView
                            style="@style/Widget.EventManager.RowLabel"
                            android:text="@string/label_starts" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilStartDate"
                            style="@style/Widget.EventManager.PillField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            app:endIconContentDescription="@string/cd_pick_date"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMinSize="36dp"
                            app:endIconMode="custom"
                            app:placeholderText="@string/placeholder_date">

                            <!-- Typed as DD/MM/YYYY (format is validated) or picked from the calendar icon -->
                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/hint_start_date"
                                android:digits="0123456789/"
                                android:imeOptions="actionNext"
                                android:inputType="date"
                                android:maxLength="10"
                                android:paddingStart="10dp"
                                android:paddingTop="12dp"
                                android:paddingEnd="0dp"
                                android:paddingBottom="12dp"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilTime"
                            style="@style/Widget.EventManager.PillField"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            app:placeholderText="@string/placeholder_time">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/hint_time"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingTop="12dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="12dp"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Ends: date + time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_s"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Space
                            android:layout_width="20dp"
                            android:layout_height="0dp" />

                        <TextView
                            style="@style/Widget.EventManager.RowLabel"
                            android:text="@string/label_ends" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEndDate"
                            style="@style/Widget.EventManager.PillField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            app:endIconContentDescription="@string/cd_pick_date"
                            app:endIconDrawable="@drawable/ic_calendar"
                            app:endIconMinSize="36dp"
                            app:endIconMode="custom"
                            app:placeholderText="@string/placeholder_date">

                            <!-- Typed as DD/MM/YYYY (format is validated) or picked from the calendar icon -->
                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/hint_end_date"
                                android:digits="0123456789/"
                                android:imeOptions="actionNext"
                                android:inputType="date"
                                android:maxLength="10"
                                android:paddingStart="10dp"
                                android:paddingTop="12dp"
                                android:paddingEnd="0dp"
                                android:paddingBottom="12dp"
                                android:textSize="15sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilEndTime"
                            style="@style/Widget.EventManager.PillField"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            app:placeholderText="@string/placeholder_time">

                            <com.google.android.material.textfield.TextInputEditText
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:contentDescription="@string/hint_end_time"
                                android:cursorVisible="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:paddingStart="8dp"
                                android:paddingTop="12dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="12dp"
                                android:inputType="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Summary: "3 days · Starts in 2 d 4 h" (updated as you type) -->
                    <LinearLayout
                        android:id="@+id/rowWhenSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginTop="@dimen/space_s"
                        android:layout_marginBottom="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:backgroundTint="@color/status_upcoming_bg"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/status_upcoming_fg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="3 days" />

                        <TextView
                            android:id="@+id/tvRelative"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:layout_weight="1"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/text_secondary"
                            tools:text="Starts in 2 d 4 h" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Where / who ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventManager.FormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <!-- Location: address suggestions + "use my location" -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLocation"
                        style="@style/Widget.EventManager.RowField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_location"
                        app:endIconContentDescription="@string/cd_use_my_location"
                        app:endIconDrawable="@drawable/ic_my_location"
                        app:endIconMode="custom"
                        app:startIconDrawable="@drawable/ic_location">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actvLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="3"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences|textPostalAddress"
                            android:maxLength="150"
                            android:paddingTop="24dp"
                            android:paddingBottom="8dp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View style="@style/Widget.EventManager.RowDivider" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilOrganiser"
                        style="@style/Widget.EventManager.RowField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_organiser"
                        app:startIconDrawable="@drawable/ic_person">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLength="100" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Optional details ===== -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.EventManager.FormCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="4dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDescription"
                        style="@style/Widget.EventManager.RowField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_description_optional"
                        app:counterEnabled="true"
                        app:counterMaxLength="500"
                        app:startIconDrawable="@drawable/ic_notes">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View style="@style/Widget.EventManager.RowDivider" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/Widget.EventManager.RowField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email_optional"
                        app:startIconDrawable="@drawable/ic_mail">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:maxLength="100" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View style="@style/Widget.EventManager.RowDivider" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        style="@style/Widget.EventManager.RowField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_phone_optional"
                        app:startIconDrawable="@drawable/ic_phone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="phone"
                            android:maxLength="20" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- What the buttons below do -->
            <TextView
                android:id="@+id/tvFormNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_xs"
                android:layout_marginTop="@dimen/space_xs"
                android:drawablePadding="8dp"
                android:text="@string/form_draft_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Pinned actions ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDraft"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:text="@string/action_save_draft"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReview"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1.4"
            android:text="@string/action_review_publish"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
